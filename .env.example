# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais commiter .env.local : il contient des secrets et des coordonnées personnelles.

# URL publique du site (SEO, liens absolus). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexation par les moteurs de recherche. Laisser vide tant que le site contient des
# données de test (robots.txt bloque tout + balise noindex). Mettre « enabled » au lancement officiel.
SITE_INDEXING=

# --- Coordonnées de TEST (à remplacer par les officielles avant la mise en ligne) ---
# Numéro WhatsApp au format international, chiffres uniquement (ex. 223XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Email de contact affiché sur le site (pied de page, page Contact).
NEXT_PUBLIC_CONTACT_EMAIL=
# Adresse qui reçoit les notifications des formulaires contact et préinscription.
FORMS_NOTIFICATION_EMAIL=

# --- Base de données : chaîne de connexion Neon PostgreSQL ---
# Neon > Connection details > « Pooled connection » (hôte contenant -pooler), en remplaçant sslmode=require par sslmode=verify-full.
# En local sans Neon : `npx prisma dev` fournit une URL postgres://localhost:...
DATABASE_URL=

# --- Emails : clé API Resend (secret, côté serveur uniquement) ---
# Sans clé, les formulaires fonctionnent mais aucune notification n'est envoyée.
RESEND_API_KEY=
# Expéditeur (facultatif). Par défaut onboarding@resend.dev, utilisable sans domaine vérifié.
RESEND_FROM_EMAIL=

# --- Limitation de débit des formulaires : clé secrète de hachage des adresses IP ---
# Générer une valeur aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais commiter .env.local : il contient des secrets et des coordonnées personnelles.

# URL publique du site (SEO, liens absolus). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Coordonnées de TEST (à remplacer par les officielles avant la mise en ligne) ---
# Numéro WhatsApp au format international, chiffres uniquement (ex. 223XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Adresse qui reçoit les notifications des formulaires contact et préinscription.
FORMS_NOTIFICATION_EMAIL=

# --- Base de données (phase 4) : chaîne de connexion Neon PostgreSQL ---
DATABASE_URL=

# --- Emails (phase 6) : clé API Resend (secret, côté serveur uniquement) ---
RESEND_API_KEY=
